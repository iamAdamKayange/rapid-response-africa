# URL of the Node API (the backend on Render). No trailing slash.
# Local:  http://localhost:4000
# Live:   https://<your-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: the Admin/Author panel (separate app). Shows a "Staff sign-in" link in the footer when set.
NEXT_PUBLIC_ADMIN_URL=
